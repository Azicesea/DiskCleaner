<Window x:Class="DiskCleaner.App.CustomRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义清理规则" Height="560" Width="760"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI"
        Background="#F5F6F8">

    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#2F6FE4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#E8EAEE" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <TextBlock Foreground="#555" TextWrapping="Wrap"
                       Text="在这里加你自己想清理的文件夹。点下面的「浏览…」直接选文件夹，也可以手写路径（支持 %TEMP% 这类环境变量和 * 通配）；写了目录就清空里面所有文件，目录本身保留。" />
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="8">
            <ListBox x:Name="RuleList" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding PathsText}" FontSize="12" Foreground="#777"
                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding RecycleText}" FontSize="11" Foreground="#999"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="名称" Width="48" VerticalAlignment="Center" Foreground="#555" />
                    <TextBox x:Name="NameBox" Width="360" Height="30" VerticalContentAlignment="Center"
                             Padding="6,0" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="路径" Width="48" VerticalAlignment="Top"
                               Margin="0,6,0,0" Foreground="#555" />
                    <TextBox x:Name="PathBox" Grid.Column="1" Height="64" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="6,4"
                             FontFamily="Consolas, Microsoft YaHei UI" />
                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                        <Button x:Name="BrowseButton" Content="浏览…" Width="86"
                                Style="{StaticResource PlainButton}" Click="BrowseButton_Click" />
                        <Button x:Name="ClearPathButton" Content="清空" Width="86" Margin="0,6,0,0"
                                Style="{StaticResource PlainButton}" Click="ClearPath_Click" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <CheckBox x:Name="RecycleBox" Content="删除时放进回收站（可还原）" IsChecked="True"
                              VerticalAlignment="Center" />
                    <Button x:Name="AddButton" Content="添加" Width="90" Margin="18,0,0,0"
                            Style="{StaticResource PrimaryButton}" Click="AddButton_Click" />
                    <Button x:Name="RemoveButton" Content="删除选中" Width="90" Margin="8,0,0,0"
                            Style="{StaticResource PlainButton}" Click="RemoveButton_Click" />
                </StackPanel>

                <TextBlock Grid.Row="3" x:Name="HintText" Foreground="#888" FontSize="12"
                           Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="点「浏览…」选文件夹，也可以直接写路径（支持 %TEMP% 和 * 通配）。一行一个，目录会递归清理里面的文件，目录本身不删。" />
            </Grid>
        </Border>

        <Button Grid.Row="3" Content="关闭" Width="90" HorizontalAlignment="Right" Margin="0,10,0,0"
                Style="{StaticResource PlainButton}" Click="Close_Click" />
    </Grid>
</Window>

<Window x:Class="DiskCleaner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="磁盘清理工具"
        Height="620" Width="980"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        Background="#F5F6F8">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="扫描目标" VerticalAlignment="Center" Foreground="#555" Margin="0,0,10,0" />
                <ComboBox x:Name="DriveCombo" Width="260" Height="32" VerticalContentAlignment="Center" />
                <Button x:Name="ScanButton" Content="开始扫描" Width="100" Height="32"
                        Margin="10,0,0,0" Click="ScanButton_Click"
                        Background="#2F6FE4" Foreground="White" BorderThickness="0" />
                <Button x:Name="CancelButton" Content="取消" Width="70" Height="32"
                        Margin="8,0,0,0" Click="CancelButton_Click" IsEnabled="False"
                        Background="#E8EAEE" BorderThickness="0" />
            </StackPanel>
        </Border>

        <!-- 进度 -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <ProgressBar x:Name="ScanProgressBar" Height="6" IsIndeterminate="True" Visibility="Collapsed" />
                <TextBlock x:Name="ProgressText" Text="选择磁盘后点「开始扫描」" Foreground="#666" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- 结果表 -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="8">
            <DataGrid x:Name="ResultGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EEF0F3"
                      BorderThickness="0"
                      RowHeight="34"
                      FontSize="13"
                      AlternatingRowBackground="#FAFBFC"
                      AlternationCount="2">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="140" />
                    <DataGridTextColumn Header="文件数" Binding="{Binding FilesText}" Width="120" />
                    <DataGridTextColumn Header="占比" Binding="{Binding PercentText}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 状态栏 -->
        <TextBlock x:Name="StatusText" Grid.Row="3" Text="" Foreground="#888" Margin="4,10,0,0" />
    </Grid>
</Window>
